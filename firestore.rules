// Firestore security rules for Anonnote
// Allow each signed-in user to read/write only their own notes.
// Deploy with: `firebase deploy --only firestore:rules` (from your Firebase project directory)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /notes/{noteId} {
      // Allow authenticated users to create notes that they own.
      // Require a userId on the incoming resource and it must equal the caller.
      allow create: if request.auth != null
        && request.resource != null
        && request.resource.data.userId == request.auth.uid;

      // Allow read/delete only if the stored document belongs to the caller.
      // Be safe: require resource exists before checking its fields.
      allow get, delete: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid;

      // Allow queries for signed-in users. Firestore evaluates per-document
      // get rules during queries so users only receive docs they may read.
      allow list: if request.auth != null;

      // Allow partial updates from the owner. If the client includes userId
      // or createdAt, they must match existing values. Otherwise allow edits.
      allow update: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid
        && (request.resource == null
            || (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == resource.data.userId)
            && (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt)
           );
    }
  }
}